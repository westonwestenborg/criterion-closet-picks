# Dependencies
node_modules/

# Build output
dist/

# Environment variables (contains API keys)
.env

# Raw transcripts (large, regenerable)
data/transcripts/

# Pipeline checkpoint files (regenerable)
data/.extraction_progress.json
data/.letterboxd_progress.json
data/.criterion_scrape_progress.json
data/checkpoint_quotes.json

# Backfill CSVs (manual data entry, not committed)
data/backfill/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Working docs/plans
docs/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Claude Code local settings (private)
.claude/settings.local.json

# Impeccable design tool (local-only; re-install with `npx impeccable install`).
# No trailing slash: the skill is a symlink to another repo, and git treats a
# symlink as a file, so a directory-only pattern would never match it.
.claude/skills/impeccable
.impeccable/

# OG image build cache
.cache/og/

# Astro generated types
.astro/

# env backups (contain secrets)
.env.bak.*
