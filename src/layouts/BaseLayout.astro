---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../lib/seo';
import '../styles/global.css';

interface Props {
  /** Page subject; the <title> becomes "<title> — Closet Picks". */
  title: string;
  /** Complete <title> text, for pages whose title already names the site. */
  documentTitle?: string;
  /** Required: a page-specific summary built from its data. See AGENTS.md → SEO. */
  description: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Emits a Pagefind filter so search can be narrowed to one kind of page. */
  searchType?: 'Guest' | 'Film';
}

const {
  title,
  documentTitle,
  description,
  ogImage: ogImageProp,
  ogType = 'website',
  noindex = false,
  searchType,
  structuredData,
} = Astro.props;
const fullTitle = documentTitle ?? `${title} — ${SITE_NAME}`;
const ogImage = new URL(ogImageProp || '/og-image.jpg', Astro.site).href;
const jsonLd = (Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [])
  .map((data) => JSON.stringify(data).replace(/</g, '\\u003c'));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:type" content={ogType} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={fullTitle} />
  <title>{fullTitle}</title>
  {!noindex && <link rel="canonical" href={Astro.url.href} />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Closet Picks" href="/feed.xml" />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/et-book-roman-line-figures.woff2" crossorigin />
  {jsonLd.map((data) => <script type="application/ld+json" set:html={data} />)}
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main" tabindex="-1" data-pagefind-filter={searchType ? `type:${searchType}` : undefined}>
    <slot />
  </main>
  <Footer />
</body>
</html>
